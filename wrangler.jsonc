{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ehrax-dev",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "drop-trailing-slash"
  },
  // Custom domain — re-enable once wrangler is logged into the CF account that owns the ehrax.dev zone.
  // "routes": [
  //   { "pattern": "ehrax.dev", "custom_domain": true }
  // ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
