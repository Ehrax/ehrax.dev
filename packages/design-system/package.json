  "devDependencies": {
    "@ehrax/typescript-config": "workspace:*",
    "@types/react": "^19.2.14",
    "react": "19.2.6",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
