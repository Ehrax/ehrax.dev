{
  "name": "@ehrax/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./theme": "./src/theme/index.ts",
    "./themes/light.css": "./src/themes/light.css",
    "./themes/dark.css": "./src/themes/dark.css"
  },
  "scripts": {
    "build": "tsc --noEmit",
