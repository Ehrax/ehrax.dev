{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "useDefineForClassFields": true,
    "noUncheckedSideEffectImports": true,
    "types": ["vite/client"]
  }
}
