{
  "name": "ehrax-dev",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "web:dev": "turbo run dev --filter=@ehrax/web",
    "web:build": "turbo run build --filter=@ehrax/web",
    "web:preview": "turbo run preview --filter=@ehrax/web",
    "web:test": "turbo run test --filter=@ehrax/web",
    "web:e2e": "turbo run e2e --filter=@ehrax/web",
    "web:deploy": "turbo run deploy --filter=@ehrax/web",
    "web:deploy:dry": "turbo run deploy:dry --filter=@ehrax/web",
    "design-system:generate:css": "turbo run generate:css --filter=@ehrax/design-system",
    "storybook": "turbo run storybook --filter=@ehrax/storybook",
    "storybook:build": "turbo run build:storybook --filter=@ehrax/storybook"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "tsx": "^4.20.3",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "react": "19.2.6",
      "react-dom": "19.2.6"
    }
  }
}
